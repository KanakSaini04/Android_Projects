<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lensora" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080808</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">#080808</item>
        <item name="postSplashScreenTheme">@style/Theme.Lensora.Main</item>
    </style>

    <style name="Theme.Lensora.Main" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
